.login-overlay {
  position: fixed;
  z-index: 1000;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  padding: 40rpx 32rpx;
  background: rgba(12, 30, 27, 0.52);
}

.login-dialog {
  position: relative;
  box-sizing: border-box;
  width: 100%;
  max-width: 660rpx;
  max-height: 88vh;
  overflow-y: auto;
  border-radius: 32rpx;
  padding: 46rpx 40rpx 24rpx;
  background: #ffffff;
  color: #17332f;
  box-shadow: 0 24rpx 80rpx rgba(0, 0, 0, 0.18);
}

button::after {
  border: 0;
}

.login-dialog__close {
  position: absolute;
  top: 14rpx;
  right: 12rpx;
  width: 68rpx;
  height: 68rpx;
  margin: 0;
  padding: 0;
  border-radius: 50%;
  background: transparent;
  color: #7f908a;
  font-size: 52rpx;
  font-weight: 300;
  line-height: 62rpx;
}

.login-dialog__title,
.login-dialog__subtitle,
.avatar-picker__label {
  display: block;
  text-align: center;
}

.login-dialog__title {
  padding: 12rpx 20rpx 0;
  font-size: 34rpx;
  font-weight: 650;
  line-height: 1.45;
}

.login-dialog__subtitle {
  margin-top: 12rpx;
  color: #6a7b77;
  font-size: 24rpx;
}

.avatar-picker {
  position: relative;
  width: 148rpx;
  height: 148rpx;
  margin: 32rpx auto 0;
  overflow: visible;
  border-radius: 50%;
  padding: 0;
  background: #e9f1ed;
  line-height: normal;
}

.avatar-picker__image,
.avatar-picker__placeholder {
  display: block;
  width: 148rpx;
  height: 148rpx;
  overflow: hidden;
  border-radius: 50%;
}

.avatar-picker__placeholder {
  position: relative;
  background: #e9f1ed;
}

.avatar-picker__head {
  position: absolute;
  top: 28rpx;
  left: 49rpx;
  width: 50rpx;
  height: 56rpx;
  border-radius: 50%;
  background: #a6bdb4;
}

.avatar-picker__shoulders {
  position: absolute;
  top: 92rpx;
  left: 24rpx;
  width: 100rpx;
  height: 70rpx;
  border-radius: 50rpx 50rpx 0 0;
  background: #a6bdb4;
}

.avatar-picker__camera {
  position: absolute;
  right: -6rpx;
  bottom: 0;
  display: flex;
  width: 46rpx;
  height: 46rpx;
  align-items: center;
  justify-content: center;
  border: 5rpx solid #ffffff;
  border-radius: 50%;
  background: #0f6b5f;
}

.camera-body {
  position: relative;
  display: flex;
  width: 27rpx;
  height: 20rpx;
  align-items: center;
  justify-content: center;
  border: 2rpx solid #ffffff;
  border-radius: 4rpx;
}

.camera-body::before {
  position: absolute;
  top: -6rpx;
  left: 6rpx;
  width: 12rpx;
  height: 4rpx;
  border-radius: 2rpx 2rpx 0 0;
  background: #ffffff;
  content: "";
}

.camera-lens {
  width: 10rpx;
  height: 10rpx;
  border: 2rpx solid #ffffff;
  border-radius: 50%;
}

.avatar-picker__label {
  margin-top: 16rpx;
  color: #62766d;
  font-size: 23rpx;
}

.nickname-row {
  display: flex;
  min-height: 90rpx;
  align-items: center;
  gap: 24rpx;
  margin-top: 30rpx;
  border-bottom: 1rpx solid #e3ebe7;
}

.nickname-row__label {
  flex-shrink: 0;
  font-size: 29rpx;
}

.nickname-row__input {
  width: 0;
  height: 80rpx;
  flex: 1;
  font-size: 28rpx;
}

.login-dialog__helper {
  margin-top: 24rpx;
  border-radius: 12rpx;
  padding: 20rpx;
  background: #f4f7f5;
  color: #74847f;
  font-size: 24rpx;
  line-height: 1.7;
}

.login-dialog__error {
  margin-top: 20rpx;
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  background: #fff3f1;
  color: #9d352c;
  font-size: 25rpx;
  line-height: 1.6;
}

.login-dialog__submit {
  margin-top: 30rpx;
  border-radius: 999rpx;
  padding: 22rpx 24rpx;
  background: #0f6b5f;
  color: #ffffff;
  font-size: 31rpx;
  font-weight: 650;
  line-height: 1.5;
}

.login-dialog__submit[disabled] {
  background: #a9bbb6;
  color: #ffffff;
}

.login-dialog__later {
  margin-top: 10rpx;
  padding: 16rpx;
  background: transparent;
  color: #6a7b77;
  font-size: 24rpx;
  line-height: 1.5;
}
