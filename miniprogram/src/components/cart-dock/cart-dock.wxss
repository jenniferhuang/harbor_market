.cart-dock { position: fixed; left: 0; right: 0; height: 110rpx; box-sizing: border-box; padding: 14rpx 24rpx; display: flex; align-items: center; gap: 20rpx; background: #fff; box-shadow: 0 -4rpx 24rpx rgba(24, 57, 50, .08); z-index: 92; }
button { margin: 0; padding: 0; border-radius: 0; background: transparent; line-height: 1.4; }
button::after { border: 0; }
.cart-summary { display: flex; align-items: center; text-align: left; flex: 1; height: 100%; min-width: 0; }
.cart-icon { position: relative; width: 72rpx; height: 72rpx; border-radius: 50%; background: #0f4c45; color: #fff; display: flex; align-items: center; justify-content: center; margin-right: 20rpx; }
.cart-basket { width: 32rpx; height: 24rpx; border: 3rpx solid #fff; border-top: 0; transform: skew(-8deg); margin-bottom: 8rpx; }
.cart-basket::before { content: ''; position: absolute; left: -10rpx; top: -7rpx; width: 10rpx; border-top: 3rpx solid #fff; }
.cart-wheel { position: absolute; bottom: 16rpx; width: 6rpx; height: 6rpx; border-radius: 50%; background: #fff; }
.wheel-left { left: 23rpx; }
.wheel-right { right: 20rpx; }
.cart-badge { position: absolute; top: -6rpx; right: -8rpx; font-size: 20rpx; min-width: 26rpx; padding: 2rpx 6rpx; border-radius: 24rpx; background: #af4934; border: 3rpx solid #fff; text-align: center; }
.total-body { display: flex; flex-direction: column; }
.total-label { color: #6a7a75; font-size: 22rpx; }
.total-price { color: #0f4c45; font-size: 34rpx; font-weight: 700; }
.cart-chevron { margin-left: auto; padding: 0 16rpx; font-size: 28rpx; color: #6a7a75; }
.checkout { padding: 22rpx 36rpx; border-radius: 40rpx; color: #fff; font-size: 28rpx; font-weight: 600; background: #0f6b5f; }
.checkout[disabled] { color: #8c9994; background: #edf2ef; }
.cart-mask { position: fixed; top: 0; bottom: 0; left: 0; right: 0; background: rgba(13, 37, 32, .42); z-index: 90; }
.cart-sheet { position: fixed; left: 0; right: 0; border-radius: 28rpx 28rpx 0 0; background: #fff; overflow: hidden; z-index: 91; }
.sheet-header { display: flex; align-items: center; padding: 24rpx 28rpx; border-bottom: 1rpx solid #edf2ef; }
.sheet-title { flex: 1; font-size: 30rpx; font-weight: 600; color: #193c34; }
.text-button { font-size: 24rpx; color: #6a7a75; padding: 8rpx 20rpx; }
.close-button { padding: 0 8rpx 0 12rpx; font-size: 40rpx; color: #6a7a75; }
.cart-lines { max-height: 58vh; }
.cart-line { display: flex; gap: 20rpx; padding: 24rpx 28rpx; border-bottom: 1rpx solid #edf2ef; }
.line-image { flex-shrink: 0; width: 116rpx; height: 116rpx; border-radius: 14rpx; }
.image-placeholder { background: #edf4ef; display: flex; align-items: center; justify-content: center; color: #7a8b83; font-size: 24rpx; }
.line-body { display: flex; flex: 1; min-width: 0; flex-direction: column; gap: 8rpx; }
.line-name { font-size: 28rpx; color: #193c34; }
.line-spec { font-size: 22rpx; color: #6a7a75; }
.line-footer { display: flex; align-items: center; justify-content: space-between; gap: 12rpx; }
.line-price { font-size: 28rpx; color: #af4934; font-weight: 600; }
.empty-cart { padding: 64rpx 28rpx; color: #6a7a75; font-size: 26rpx; text-align: center; }
.cart-error { display: block; padding: 16rpx 28rpx; color: #a3342a; font-size: 24rpx; }
.line-selection { display: flex; align-items: center; justify-content: center; flex-shrink: 0; width: 40rpx; }

.cart-dock button.cart-summary,
.cart-dock button.checkout,
.cart-sheet button.text-button,
.cart-sheet button.close-button { width: auto; }
.cart-sheet button.line-selection { width: 40rpx; }
.selection-mark { box-sizing: border-box; display: flex; align-items: center; justify-content: center; width: 36rpx; height: 36rpx; border: 2rpx solid #bdcfc5; border-radius: 50%; background: #fff; color: #fff; font-size: 23rpx; }
.selection-mark--selected { background: #176b55; border-color: #176b55; }
