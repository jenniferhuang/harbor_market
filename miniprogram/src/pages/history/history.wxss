.history-heading { display: flex; align-items: center; justify-content: space-between; }
.text-button { margin: 0; padding: 10rpx 0 10rpx 24rpx; color: #64746d; background: transparent; font-size: 26rpx; }
.history-list { margin-top: 28rpx; padding: 0 24rpx; }
.history-item { display: flex; align-items: center; gap: 22rpx; margin: 0; padding: 24rpx 0; background: #fff; text-align: left; border-radius: 0; }
.history-item + .history-item { border-top: 1rpx solid #edf1ee; }
.history-item__image { width: 142rpx; height: 142rpx; border-radius: 16rpx; flex-shrink: 0; }
.history-item__placeholder { display: flex; align-items: center; justify-content: center; background: #eaf1ec; color: #6c8076; font-size: 26rpx; }
.history-item__copy { flex: 1; min-width: 0; }
.history-item__name { display: block; color: #17332f; font-size: 28rpx; line-height: 1.5; overflow-wrap: break-word; }
.history-item__date { display: block; margin: 6rpx 0; color: #7b8981; font-size: 22rpx; }
.history-item__arrow { color: #7b8981; font-size: 36rpx; }
.history-note { display: block; margin: 28rpx 0; color: #77867e; font-size: 25rpx; line-height: 1.7; text-align: center; }
.history-error { margin-top: 24rpx; padding: 24rpx; background: #fff3f1; color: #9d352c; border-radius: 16rpx; font-size: 26rpx; }
.history-error button { margin-top: 18rpx; }
.history-more { margin-top: 24rpx; }
