<view class="page-shell">
  <text class="page-heading">我的收藏</text>
  <view wx:if="{{!loggedIn}}" class="surface status-panel"><text class="status-panel__title">登录后查看收藏</text><button class="primary-button status-panel__action" bindtap="login">去登录</button></view>
  <block wx:else>
    <view wx:if="{{loading}}" class="muted list-message" aria-role="status">正在加载收藏…</view>
    <view wx:if="{{errorMessage}}" class="error-message" aria-role="alert"><text>{{errorMessage}}</text><button class="secondary-button" bindtap="loadItems">重试</button></view>
    <view wx:if="{{!loading && !items.length && !errorMessage}}" class="surface status-panel"><text class="status-panel__title">还没有收藏商品</text><text class="status-panel__message">在商品详情中点击收藏，喜欢的好物就会保存在这里。</text><button class="secondary-button status-panel__action" bindtap="continueShopping">去选购</button></view>
    <view class="favorite-grid">
      <view wx:for="{{items}}" wx:key="productCode"><product-card item="{{item}}" bind:select="openProduct" /><button class="remove-favorite" data-code="{{item.productCode}}" disabled="{{!!removing}}" bindtap="removeFavorite">{{removing == item.productCode ? '正在取消…' : '取消收藏'}}</button></view>
    </view>
    <button wx:if="{{hasMore}}" class="secondary-button load-more" disabled="{{loading}}" bindtap="loadMore">{{loading ? '正在加载…' : '加载更多'}}</button>
  </block>
</view>
