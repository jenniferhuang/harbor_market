.product-page { box-sizing: border-box; min-height: 100vh; padding-bottom: calc(136rpx + env(safe-area-inset-bottom)); }
.gallery { position: relative; background: #e8f0ed; }
.gallery__swiper { height: 680rpx; }
.gallery__image, .gallery__placeholder { width: 100%; height: 100%; }
.gallery__placeholder { display: flex; flex-direction: column; align-items: center; justify-content: center; color: #759088; font-size: 36rpx; font-weight: 700; }
.gallery__placeholder-hint { margin-top: 16rpx; font-size: 24rpx; font-weight: 400; }
.gallery__count { position: absolute; right: 24rpx; top: 616rpx; border-radius: 999rpx; padding: 8rpx 20rpx; background: rgba(23, 51, 47, .65); color: #fff; font-size: 23rpx; }
.gallery__thumbs { width: 100%; padding: 16rpx 0; background: #fff; white-space: nowrap; }
.gallery__thumb-row { display: inline-flex; gap: 14rpx; padding: 0 24rpx; }
.gallery__thumb { box-sizing: border-box; width: 88rpx; height: 88rpx; margin: 0; overflow: hidden; border: 3rpx solid transparent; border-radius: 12rpx; padding: 0; background: #edf2f0; }
.gallery__thumb--active { border-color: #0f6b5f; }
.gallery__thumb image { width: 100%; height: 100%; }
.product-content { display: flex; flex-direction: column; gap: 22rpx; padding: 24rpx 24rpx 36rpx; }
.product-summary, .choice-card, .detail-card { padding: 28rpx; }
.product-summary__price-row { display: flex; align-items: baseline; gap: 12rpx; }
.product-summary__price { font-size: 46rpx; }
.product-summary__unit { color: #71817c; font-size: 24rpx; margin-left: 4rpx; }
.product-summary__market-price, .sku-row__market { margin-left: 12rpx; color: #85928f; font-size: 24rpx; text-decoration: line-through; }
.product-summary__heading { display: flex; gap: 16rpx; align-items: flex-start; margin-top: 20rpx; }
.product-summary__title { min-width: 0; flex: 1; }
.product-summary__name { display: block; color: #153d35; font-size: 38rpx; font-weight: 700; line-height: 1.4; }
.product-summary__subtitle { display: block; margin-top: 10rpx; color: #61736e; line-height: 1.55; }
.product-favorite { display: flex; flex-direction: column; align-items: center; justify-content: center; flex-shrink: 0; min-width: 100rpx; min-height: 92rpx; margin: 0; border-radius: 16rpx; padding: 6rpx 10rpx; background: #f4f8f6; color: #657a73; font-size: 22rpx; line-height: 1.3; }
.product-favorite__icon { font-size: 41rpx; }
.product-favorite--active { background: #eaf5f1; color: #0f6b5f; }
.product-summary__meta { display: flex; flex-wrap: wrap; align-items: center; gap: 14rpx; margin-top: 24rpx; color: #667a74; font-size: 23rpx; }
.product-summary__stock { margin-left: auto; }
.tag-row { display: flex; margin-top: 20rpx; flex-wrap: wrap; gap: 12rpx; }
.tag { border-radius: 999rpx; padding: 6rpx 14rpx; background: #e8f4f0; color: #12685c; font-size: 23rpx; }
.selection-entry { display: flex; align-items: center; gap: 24rpx; width: 100%; margin: 0; padding: 0; background: transparent; text-align: left; line-height: 1.5; }
.selection-entry__label { color: #81908a; font-size: 26rpx; }
.selection-entry__content { min-width: 0; flex: 1; color: #284c42; font-weight: 600; }
.selection-entry__quantity { display: block; margin-top: 8rpx; color: #7b8b85; font-size: 23rpx; font-weight: 400; }
.selection-entry__arrow { color: #8b9b94; font-size: 44rpx; }
.choice-card__add { width: 100%; margin: 24rpx 0 0; min-height: 82rpx; }
.section-title { display: block; color: #183d36; font-size: 30rpx; font-weight: 700; }
.detail-help { display: block; margin-top: 10rpx; color: #778a82; font-size: 23rpx; line-height: 1.5; }
.selling-points { margin-top: 18rpx; }
.selling-point { display: flex; margin-top: 12rpx; align-items: flex-start; gap: 14rpx; line-height: 1.55; }
.selling-point__marker { color: #0f6b5f; font-weight: 700; }
.attribute-row { display: flex; gap: 26rpx; margin-top: 24rpx; font-size: 25rpx; line-height: 1.6; }
.attribute-row__label { width: 126rpx; flex-shrink: 0; color: #809087; }
.attribute-row__value { min-width: 0; flex: 1; color: #415d53; overflow-wrap: break-word; }
.sku-row { margin-top: 22rpx; border-top: 1rpx solid #e4ece8; padding-top: 22rpx; }
.sku-row__heading { display: flex; align-items: baseline; justify-content: space-between; gap: 18rpx; }
.sku-row__name { font-weight: 600; line-height: 1.5; }
.sku-row__prices { flex-shrink: 0; text-align: right; }
.sku-row__attributes { display: block; margin-top: 8rpx; color: #6e8179; font-size: 24rpx; line-height: 1.5; }
.sku-row__meta { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 14rpx; margin-top: 12rpx; color: #7a8a83; font-size: 22rpx; }
.sku-row__stock--empty { color: #9c6655; }
.detail-copy { display: block; margin-top: 16rpx; color: #50655f; line-height: 1.8; white-space: pre-wrap; }
.detail-row + .detail-row { margin-top: 24rpx; border-top: 1rpx solid #e3eae7; padding-top: 24rpx; }
.image-detail-card { overflow: hidden; }
.image-detail-card__title { padding: 28rpx; }
.detail-image { display: block; width: 100%; height: auto; }
.spec-overlay { position: fixed; z-index: 200; top: 0; right: 0; bottom: 0; left: 0; }
.spec-overlay__mask { position: absolute; top: 0; right: 0; bottom: 0; left: 0; background: rgba(14, 34, 27, .5); }
.spec-sheet { position: absolute; right: 0; bottom: 0; left: 0; display: flex; flex-direction: column; max-height: 86vh; border-radius: 32rpx 32rpx 0 0; background: #fff; padding: 28rpx 28rpx 0; }
.spec-sheet__header { display: flex; align-items: center; gap: 22rpx; position: relative; padding: 0 60rpx 24rpx 0; border-bottom: 1rpx solid #e4ece8; }
.spec-sheet__cover { width: 150rpx; height: 150rpx; flex-shrink: 0; border-radius: 16rpx; background: #eef4f1; }
.spec-sheet__cover--empty { display: flex; align-items: center; justify-content: center; color: #93a39c; font-size: 22rpx; }
.spec-sheet__summary { flex: 1; min-width: 0; }
.spec-sheet__name { display: block; margin-bottom: 8rpx; font-size: 27rpx; font-weight: 600; line-height: 1.5; }
.spec-sheet__price { font-size: 37rpx; }
.spec-sheet__stock { display: block; margin-top: 8rpx; color: #81918a; font-size: 24rpx; }
.spec-sheet__close { position: absolute; top: -8rpx; right: -8rpx; display: flex; align-items: center; justify-content: center; width: 64rpx; height: 64rpx; margin: 0; padding: 0; background: transparent; color: #6e8077; font-size: 48rpx; line-height: 1; }
.spec-sheet__body { box-sizing: border-box; min-height: 0; height: 56vh; max-height: 56vh; flex-shrink: 1; }
.specification { margin-top: 26rpx; }
.specification__heading { display: flex; align-items: baseline; justify-content: space-between; gap: 18rpx; }
.specification__name { font-size: 28rpx; font-weight: 650; }
.specification__mode { color: #73837f; font-size: 23rpx; }
.option-grid { display: flex; margin-top: 16rpx; flex-wrap: wrap; gap: 14rpx; }
.option-button { display: inline-flex; width: auto; min-height: 76rpx; margin: 0; align-items: center; gap: 8rpx; border: 1rpx solid #c8d8d3; border-radius: 14rpx; padding: 14rpx 20rpx; background: #f6f8f7; color: #425b55; font-size: 25rpx; line-height: 1.35; }
.option-button--selected { border: 2rpx solid #0f6b5f; background: #eaf5f1; color: #0f5e53; font-weight: 650; }
.option-button__price { color: #b84f1d; font-size: 22rpx; }
.selection-summary, .selection-hint { display: block; margin-top: 20rpx; color: #657772; font-size: 24rpx; line-height: 1.6; }
.selection-hint { border-radius: 12rpx; padding: 14rpx; background: #fff4ef; color: #a04726; }
.spec-sheet__sku-code { display: block; margin-top: 8rpx; color: #839188; font-size: 22rpx; }
.quantity-card { display: flex; justify-content: space-between; align-items: center; gap: 24rpx; margin-top: 26rpx; padding: 26rpx 0; border-top: 1rpx solid #e4ece8; }
.spec-sheet__footer { padding: 22rpx 0 calc(22rpx + env(safe-area-inset-bottom)); border-top: 1rpx solid #e4ece8; }
.spec-sheet__footer button { margin: 0; width: 100%; border-radius: 999rpx; }

.product-coupon-entry { display: flex; justify-content: space-between; gap: 20rpx; margin: 20rpx 0 0; padding: 24rpx 28rpx; background: #edf7f1; color: #0f6b5f; border-radius: 20rpx; font-size: 26rpx; line-height: 1.5; }
.product-coupon-entry::after { border: 0; }
