<view class="page-shell">
  <text class="page-heading">购买记录</text>
  <view wx:if="{{!loggedIn}}" class="surface status-panel"><text class="status-panel__title">登录后查看购买记录</text><button class="primary-button status-panel__action" bindtap="login">去登录</button></view>
  <block wx:else>
    <view wx:if="{{loading}}" class="muted list-message" aria-role="status">正在加载购买记录…</view>
    <view wx:if="{{errorMessage}}" class="error-message" aria-role="alert"><text>{{errorMessage}}</text><button class="secondary-button" bindtap="loadItems">重试</button></view>
    <view wx:if="{{!loading && !items.length && !errorMessage}}" class="surface status-panel"><text class="status-panel__title">暂时没有购买记录</text><text class="status-panel__message">关联到当前微信账户的已成交记录会显示在这里。</text></view>
    <view wx:for="{{items}}" wx:key="id" class="surface order">
      <view class="order__heading"><text>{{item.completedLabel}}</text><text>{{item.statusLabel}}</text></view>
      <text class="order__reference">单号：{{item.external_reference}}</text>
      <button wx:for="{{item.items}}" wx:for-item="line" wx:key="product_code" class="order__line" data-code="{{line.product_code}}" bindtap="openProduct"><text>{{line.product_name}}</text><text>{{line.displayPrice}} × {{line.quantity}}</text></button>
      <text class="order__total">合计 {{item.displayTotal}}</text>
    </view>
    <button wx:if="{{hasMore}}" class="secondary-button load-more" disabled="{{loading}}" bindtap="loadMore">{{loading ? '正在加载…' : '加载更多'}}</button>
  </block>
</view>
